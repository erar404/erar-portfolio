# SMTP settings for the contact form (Gmail example: smtp.gmail.com, port 587, app password)
smtp_host=smtp.gmail.com
smtp_port=587
smtp_email=your-smtp-login@gmail.com
smtp_password=your-app-password
send_to_email=it.arellanoerwin@gmail.com

# Public URL of the deployed site, used for Open Graph and Twitter preview images.
# On Vercel this falls back to the project production URL automatically.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
